# Base de datos Postgres (Supabase, Railway, Render, etc.)
DATABASE_URL=postgres://usuario:clave@host:5432/comprobado
# Dirección pública del servidor, sin barra final (se usa en el script de la landing y en el webhook de Kommo).
# En Render y Railway se detecta sola: no hace falta cargarla.
PUBLIC_URL=https://tu-servidor.up.railway.app
# Clave para cifrar los tokens de Meta y Kommo: un texto aleatorio de 32 caracteres o más
# (por ejemplo una contraseña generada de 48 caracteres, o: openssl rand -base64 32).
# Si la perdés o la cambiás, hay que volver a cargar los tokens de todas las cuentas.
APP_ENCRYPTION_KEY=
# Clave de la API de Anthropic (Claude) para leer los comprobantes
ANTHROPIC_API_KEY=
# Tu usuario administrador: se crea en el primer arranque. Después borrá ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opcionales
# RECEIPT_MODEL=claude-opus-5-5
# META_API_VERSION=v21.0
